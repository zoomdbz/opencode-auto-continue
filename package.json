{
  "name": "opencode-auto-continue",
  "version": "0.2.0",
  "description": "OpenCode plugin that automatically sends a continuation prompt when sessions go idle",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c -w",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjzccc/opencode-auto-continue.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "auto-continue"
  ],
  "devDependencies": {
    "@opencode/plugin": "^2.0.32",
    "@types/node": "^22.0.0",
    "rolldown": "^1.1.4",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  }
}
